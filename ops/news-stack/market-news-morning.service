[Unit]
Description=Codex FINAL selects stocks from dated source news
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /home/jadhavdnyaneshwar701/market-news-db/current/ops/news-stack/run-news-job.sh morning
TimeoutStartSec=4min

ExecStopPost=-/usr/bin/bash -c 'if /usr/bin/docker container inspect market-news-morning-job >/dev/null 2>&1; then /usr/bin/docker stop -t 5 market-news-morning-job; fi'
